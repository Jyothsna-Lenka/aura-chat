# ---- server/.env ----
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aura-chat?retryWrites=true&w=majority
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=<primary-model, e.g. a Flash model>
GEMINI_FALLBACK_MODEL=<fallback-model, e.g. a Flash-Lite model>
LLM_MAX_TOKENS=2048
CLIENT_ORIGIN=http://localhost:5173

# ---- client/.env ----
VITE_API_BASE_URL=http://localhost:5000/api
